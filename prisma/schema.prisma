// prisma/schema.prisma
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/* ===========================
 * Enums
 * =========================== */

enum AllergenCategory {
  DOG
  FOOD
}

enum AttendanceStatus {
  ATTEND
  DECLINE
}

/* ===========================
 * Models
 * =========================== */

/**
 * 参加者（代表者＋同伴者）
 */
model Guest {
  id                Int               @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String?
  phone             String?

  // ★ 必須：生年月日（時刻不要なので @db.Date 推奨）
  birthDate         DateTime          @db.Date

  attendance        AttendanceStatus

  // どの招待トークンから回答したか（任意）
  invitationTokenId Int?
  invitationToken   InvitationToken?  @relation(fields: [invitationTokenId], references: [id], onDelete: SetNull)

  // アレルギー（多対多）
  allergies         GuestAllergy[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([lastName, firstName, birthDate])
  @@unique([lastName, firstName, birthDate], map: "uniq_guest_name_dob")
  @@index([attendance])
  @@index([invitationTokenId])
}

/**
 * 招待トークン
 * 1トークン=1回答の想定。回答完了で isUsed=true, usedAt=NOW。
 */
model InvitationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  inviteeName   String   // 招待者表示名など
  isUsed    Boolean  @default(false)
  usedAt    DateTime?

  guests    Guest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * アレルゲンのマスタ（カテゴリ＋名称で一意）
 */
model Allergen {
  id        Int               @id @default(autoincrement())
  category  AllergenCategory
  name      String

  guests    GuestAllergy[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([category, name], name: "category_name_unique")
  @@index([category])
}

/**
 * 中間テーブル：Guest × Allergen
 */
model GuestAllergy {
  guestId    Int
  allergenId Int
  notedAt    DateTime @default(now())

  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([guestId, allergenId])
  @@index([allergenId])
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique          // 表示/通知用。基本は小文字で保存
  canonical String   @unique          // 認可判定用の正規化キー
  createdAt DateTime @default(now())
}